msgid "plugins.generic.editorialDocumentPreviewer.name"
msgstr "Editorial Document Previewer"

msgid "plugins.generic.editorialDocumentPreviewer.description"
msgstr "Enables instant in-browser modal previews for submitted documents, manuscripts, and supplementary files across all editorial workflow stages without downloading files."

msgid "plugins.generic.editorialDocumentPreviewer.previewButton"
msgstr "Preview"

msgid "plugins.generic.editorialDocumentPreviewer.previewTitle"
msgstr "Document Preview"

msgid "plugins.generic.editorialDocumentPreviewer.downloadFile"
msgstr "Download Original"

msgid "plugins.generic.editorialDocumentPreviewer.closePreview"
msgstr "Close Preview"

msgid "plugins.generic.editorialDocumentPreviewer.loading"
msgstr "Loading document preview..."

msgid "plugins.generic.editorialDocumentPreviewer.unsupportedFormat"
msgstr "Preview is not directly available for this file format. Please use the download button to inspect the document locally."

msgid "plugins.generic.editorialDocumentPreviewer.unauthorized"
msgstr "You are not authorized to preview this document."

msgid "plugins.generic.editorialDocumentPreviewer.openInNewTab"
msgstr "Open in New Tab"

msgid "plugins.generic.editorialDocumentPreviewer.zoomIn"
msgstr "Zoom In"

msgid "plugins.generic.editorialDocumentPreviewer.zoomOut"
msgstr "Zoom Out"

msgid "plugins.generic.editorialDocumentPreviewer.resetZoom"
msgstr "Reset Zoom"

msgid "plugins.generic.editorialDocumentPreviewer.fitWidth"
msgstr "Fit to Width"

msgid "plugins.generic.editorialDocumentPreviewer.fullScreen"
msgstr "Full Screen"

msgid "plugins.generic.editorialDocumentPreviewer.exitFullScreen"
msgstr "Exit Full Screen"
